layout {

    focus-ring {
        active-color   "#ffb962"
        inactive-color "#101923"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb962"
        inactive-color "#101923"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb962"
        inactive-color "#af6100"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb96280"
    }
}

recent-windows {
    highlight {
        active-color "#ffb962"
        urgent-color "#ffb4ab"
    }
}
