binds {
  // #"Apps"
  Mod+Return hotkey-overlay-title="Open Terminal" { spawn "kitty"; }
  Mod+R hotkey-overlay-title="Open Terminal" { spawn "kitty"; }
  Mod+E hotkey-overlay-title="Open File Manager" { spawn "nautilus"; }
  Mod+W hotkey-overlay-title="Open Browser" { spawn-sh "zen-browser --blank-window"; }
  Mod+O hotkey-overlay-title="Open Obsidian" { spawn-sh "mount /home/cachy/SD && obsidian"; }
  Mod+V hotkey-overlay-title="Open VBox" { spawn "virtualbox"; }

  // #"Noctalia"
  Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
  Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
  Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
  Mod+Ctrl+L { spawn-sh "noctalia msg session lock"; }
  Mod+Shift+Q { spawn-sh "noctalia msg panel-toggle session"; }

  // #"Window management"
  Mod+Q { close-window; }
  Mod+F { maximize-column; }
  Mod+M { fullscreen-window; }
  Mod+Minus { set-column-width "-10%"; }
  Mod+Equal { set-column-width "+10%"; }

  // #"Navigation"
  Mod+H { focus-column-left; }
  Mod+L { focus-column-right; }
  Mod+J { focus-workspace-down; }
  Mod+K { focus-workspace-up; }
  Mod+Alt+J { focus-window-down; }
  Mod+Alt+K { focus-window-up; }
  Mod+Shift+Alt+H { move-workspace-to-monitor-left; }
  Mod+Shift+Alt+L { move-workspace-to-monitor-right; }

  Mod+Shift+H { move-column-left; }
  Mod+Shift+L { move-column-right; }
  Mod+Shift+J { move-window-to-workspace-down; }
  Mod+Shift+K { move-window-to-workspace-up; }

  Mod+Alt+H { consume-or-expel-window-left; }
  Mod+Alt+L { consume-or-expel-window-right; }

  Mod+T { toggle-window-floating; }
  Mod+Shift+W { set-column-width "50%"; }

  // #"Media controls"
  XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
  XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
  XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }

  XF86AudioPlay         hotkey-overlay-title="Play/Pause Track" allow-when-locked=true { spawn-sh "playerctl play-pause"; }
  XF86AudioPrev         hotkey-overlay-title="Previous Track" allow-when-locked=true { spawn-sh "playerctl previous"; }
  XF86AudioNext         hotkey-overlay-title="Next Track" allow-when-locked=true { spawn-sh "playerctl next"; }

  XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
  XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

  // #"Misc"
  Mod+Tab { toggle-overview; }
  Mod+Shift+Slash hotkey-overlay-title="Open Hotkey Cheatsheet" { spawn-sh "noctalia msg panel-toggle kenn/keybind-cheatsheet:cheatsheet"; }

  Print hotkey-overlay-title="Take Screenshot" { screenshot; }
}
