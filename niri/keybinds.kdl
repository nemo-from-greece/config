binds {
  // #"Apps"
  Mod+Return hotkey-overlay-title="Open Terminal" { spawn "kitty"; }
  Mod+E hotkey-overlay-title="Open File Manager" { spawn "nautilus"; }
  Mod+W hotkey-overlay-title="Open Browser" { spawn-sh "zen-browser --blank-window"; }
  Mod+O hotkey-overlay-title="Open Obsidian" { spawn "obsidian"; }
  Mod+V hotkey-overlay-title="Open VBox" { spawn "virtualbox"; }

  // #"Noctalia"
  Mod+Space { spawn-sh "qs -c noctalia-shell ipc call launcher toggle"; }
  Mod+S { spawn-sh "qs -c noctalia-shell ipc call controlCenter toggle"; }
  Mod+Comma { spawn-sh "qs -c noctalia-shell ipc call settings toggle"; }
  Mod+Ctrl+L { spawn-sh "qs -c noctalia-shell ipc call lockScreen lock"; }
  Mod+Shift+Q { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
  Mod+N { spawn-sh "qs -c noctalia-shell ipc call notifications toggleHistory"; }
  Mod+Shift+N { spawn-sh "qs -c noctalia-shell ipc call notifications clear"; }


  // #"Window management"
  Mod+Q { close-window; }
  Mod+F { maximize-column; }
  Mod+M { fullscreen-window; }
  Mod+Minus { set-column-width "-10%"; }
  Mod+Equal { set-column-width "+10%"; }

  // #"Navigation"
  Mod+H { focus-column-left; }
  Mod+L { focus-column-right; }
  Mod+J { focus-workspace-down; }
  Mod+K { focus-workspace-up; }
  Mod+Alt+J { focus-window-down; }
  Mod+Alt+K { focus-window-up; }

  Mod+Shift+H { move-column-left; }
  Mod+Shift+L { move-column-right; }
  Mod+Shift+J { move-window-to-workspace-down; }
  Mod+Shift+K { move-window-to-workspace-up; }

  Mod+Alt+H { consume-or-expel-window-left; }
  Mod+Alt+L { consume-or-expel-window-right; }

  // #"Media controls"
  XF86AudioRaiseVolume  hotkey-overlay-title="Raise Volume" allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
  XF86AudioLowerVolume  hotkey-overlay-title="Lower Volume" allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
  XF86AudioMute         hotkey-overlay-title="Mute Audio"   allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }

  XF86AudioPlay         hotkey-overlay-title="Play/Pause Track" allow-when-locked=true { spawn-sh "playerctl play-pause"; }
  XF86AudioPrev         hotkey-overlay-title="Previous Track" allow-when-locked=true { spawn-sh "playerctl previous"; }
  XF86AudioNext         hotkey-overlay-title="Next Track" allow-when-locked=true { spawn-sh "playerctl next"; }

  XF86MonBrightnessUp   hotkey-overlay-title="Raise Screen Brightness" allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
  XF86MonBrightnessDown hotkey-overlay-title="Lower Screen Brightness" allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

  // #"Misc"
  Mod+Tab { toggle-overview; }
  Mod+Shift+Slash hotkey-overlay-title="Open Hotkey Cheatsheet" { spawn-sh "qs -c noctalia-shell ipc call plugin:keybind-cheatsheet toggle"; }

  Print hotkey-overlay-title="Take Screenshot" { screenshot; }
}
